NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never expose in client code or commit .env.local
OPENAI_API_KEY=sk-your-key-here

# Discovery model for Project Assistant AI analysis (default: gpt-5-mini)
# OPENAI_DISCOVERY_MODEL=gpt-5-mini

# Optional: model for `npm run test:openai` connectivity check
# OPENAI_TEST_MODEL=gpt-4o-mini
